# ---------------------------------------------------------------------------
# Model layer. Different tasks use different providers (see docs). Keys are
# read from the environment only — put real values in .env.local, never commit.
# We are not using Claude/Anthropic in this project.
# ---------------------------------------------------------------------------

# Chat: extract explicit trip updates from a user message (strict JSON).
GPT_API_KEY=
GPT_MODEL=gpt-5.6-luna
GPT_REASONING_EFFORT=high
GPT_BASE_URL=https://api.openai.com/v1

# Itinerary generation (OpenAI-compatible endpoint).
DEEPSEEK_API_KEY=
DEEPSEEK_MODEL=deepseek-v4-flash
DEEPSEEK_BASE_URL=https://api.deepseek.com

# MiniMax (OpenAI-compatible) — reserved for a later task; leave blank for now.
MINIMAX_API_KEY=
MINIMAX_MODEL=
MINIMAX_BASE_URL=https://api.minimaxi.chat/v1

# When any model call fails or returns something off-schema, agents fall back to
# deterministic output — the request always completes.

# Optional GPT profile for extracting explicit chat updates.
GPT_API_KEY=
GPT_MODEL=gpt-5.6-luna
GPT_REASONING_EFFORT=high
GPT_BASE_URL=https://api.openai.com/v1

# Optional OpenAI-compatible model for ItineraryPlannerAgent.
DEEPSEEK_API_KEY=
DEEPSEEK_MODEL=deepseek-v4-flash
DEEPSEEK_BASE_URL=https://api.deepseek.com

# External tools: true = use local mocks, no real key needed for development.
USE_MOCK_TOOLS=true
MAPS_API_KEY=
MOCK_API_URL=http://localhost:4000

# Memory store (E owns this — swap for SQLite/Redis later)
DATABASE_URL=file:./dev.db
# REDIS_URL=redis://localhost:6379
