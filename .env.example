# ---------------------------------------------------------------------------
# Model layer. Different tasks use different providers (see docs). Keys are
# read from the environment only — put real values in .env.local, never commit.
# We are not using Claude/Anthropic in this project.
# ---------------------------------------------------------------------------

# Chat: extract explicit trip updates from a user message (strict JSON).
# Without a key, a conservative local rule parser is used instead.
GPT_API_KEY=
GPT_MODEL=gpt-5.6-luna
GPT_REASONING_EFFORT=high
GPT_BASE_URL=https://api.openai.com/v1

# All five specialists, the supervisor agent and chat replies (OpenAI-compatible
# endpoint). See MODEL_ROUTING in packages/agents/src/models.ts.
DEEPSEEK_API_KEY=
DEEPSEEK_MODEL=deepseek-v4-flash
DEEPSEEK_BASE_URL=https://api.deepseek.com

# MiniMax is wired up but NOT currently routed to any agent: it answered in
# 15-25s per structured call, which pushed a full page render to 37-81s against
# ~20s on DeepSeek. See MODEL_ROUTING in packages/agents/src/models.ts to switch
# destination-guide and dining back to it.
# MiniMax runs two independent account systems: the mainland-China site
# (api.minimaxi.com) and the international site (api.minimax.io). Keys are NOT
# interchangeable — using one site's key against the other returns HTTP 401
# "invalid api key (2049)". The default below is the mainland-China endpoint.
MINIMAX_API_KEY=
MINIMAX_MODEL=MiniMax-M2.7
MINIMAX_BASE_URL=https://api.minimaxi.com/v1

# When any model call fails or returns something off-schema, agents fall back to
# deterministic output — the request always completes.

# Agent tools: true = in-process map and booking fixtures, no real key needed.
USE_MOCK_TOOLS=true
# With USE_MOCK_TOOLS=false, MAPS_PROVIDER selects the agents' maps adapter:
# "osm" (free Nominatim + OSRM) or "google" (requires MAPS_API_KEY). If unset,
# google is chosen when MAPS_API_KEY is present, otherwise osm.
MAPS_PROVIDER=osm
# Nominatim requires a real contact; replace the placeholder before real traffic.
OSM_USER_AGENT=ai-trip-planner/1.0 (contact@example.com)
NOMINATIM_BASE_URL=https://nominatim.openstreetmap.org
OSRM_BASE_URL=https://router.project-osrm.org

# Google Maps Platform for the web workspace (and the "google" provider above).
# Server key: Places search/details, Routes and Time Zone API routes.
MAPS_API_KEY=
# Browser key and optional Map ID for the Maps JavaScript map. Without the key the
# workspace shows a map fallback; the itinerary stays usable.
NEXT_PUBLIC_GOOGLE_MAPS_API_KEY=
NEXT_PUBLIC_GOOGLE_MAPS_MAP_ID=

# Optional stub server (`pnpm mock-server`, also started by docker compose).
# Not read by current code; the in-process fixtures above are used instead.
MOCK_API_URL=http://localhost:4000

# Reserved for a durable memory store. Not read yet: memory is in-process.
DATABASE_URL=file:./dev.db
# REDIS_URL=redis://localhost:6379
